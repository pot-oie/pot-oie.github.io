---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SeriesNavigation from "../components/SeriesNavigation.astro";
import MobileReadingNavigation from "../components/MobileReadingNavigation.astro";
import SeriesPostPager from "../components/SeriesPostPager.astro";
import BackToTop from "../components/BackToTop.astro";
import TechnicalCodeRuntime from "../components/runtime/TechnicalCodeRuntime.astro";
import TechnicalReadingRuntime from "../components/runtime/TechnicalReadingRuntime.astro";
import type { BlogSeries } from "../utils/blog";
import { Icon } from "astro-icon/components";
import {
  TECH_CATEGORY_META_LIST,
  getBlogTagMeta,
  DEFAULT_TAG_META,
} from "../consts";
import type { ArticleSeo } from "../utils/seo";

type Props = Omit<CollectionEntry<"blog">["data"], "series"> & {
  headings?: MarkdownHeading[];
  series?: BlogSeries;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  coverImage,
  techCategory,
  tags = [],
  headings = [],
  series,
} = Astro.props;

const categoryMeta = TECH_CATEGORY_META_LIST.find(
  (item) => item.key === techCategory,
);
const hasSeriesNav = Boolean(series && series.items.length > 1);
const hasToc = headings.some((heading) => heading.depth > 1 && heading.depth <= 3);
const socialImage = heroImage ?? coverImage;
const articleSeo: ArticleSeo = {
  publishedTime: pubDate,
  modifiedTime: updatedDate,
  section: categoryMeta?.label ?? "技术学习",
  tags,
  breadcrumbs: [
    { name: "博客", href: "/blog/" },
    { name: "学习", href: "/blog/learn/" },
    ...(categoryMeta
      ? [
          {
            name: categoryMeta.label,
            href: `/blog/learn/${categoryMeta.slug}/`,
          },
        ]
      : []),
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  article={articleSeo}
  articleRuntime
>
  <div class="relative w-full">
    {
      hasSeriesNav && series && (
        <aside
          class="hidden xl:block fixed top-32 right-[calc(50%+28rem)] 2xl:right-[calc(50%+29rem)] w-44 2xl:w-56 h-[calc(52vh-8rem)] overflow-hidden z-10 opacity-90 hover:opacity-100 transition-opacity duration-300"
          data-lenis-prevent
        >
          <SeriesNavigation series={series} />
        </aside>
      )
    }

    {
      hasToc && (
        <aside
          class="toc-scroll side-scroll-fade hidden xl:block fixed top-32 left-[calc(50%+26rem)] w-72 h-[calc(100vh-10rem)] overflow-y-auto overflow-x-hidden overscroll-contain z-10 opacity-80 hover:opacity-100 transition-opacity duration-300"
          data-lenis-prevent
        >
          <TableOfContents headings={headings} />
        </aside>
      )
    }

    <article
      class="page-fade-in py-6 md:py-16 w-full max-w-4xl mx-auto px-3 md:px-6 relative z-0"
    >
      <header class="mb-8 md:mb-12" data-pagefind-ignore>
        <a
          href="/"
          class="inline-flex items-center gap-2 text-ink-500 hover:text-vermilion transition-all mb-6 text-sm tracking-widest uppercase group active:scale-95"
        >
          <Icon
            name="mingcute:arrow-left-line"
            class="group-hover:-translate-x-1 transition-transform"
          />
          <span>Return</span>
        </a>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span
            class="inline-flex items-center gap-1 text-xs font-semibold tracking-widest uppercase px-2 py-1 rounded border border-ink-300 text-ink-700 dark:border-zinc-600 dark:text-zinc-300"
          >
            <Icon
              name={categoryMeta?.icon || "mingcute:book-2-line"}
              class="w-4 h-4"
            />
            {categoryMeta?.label || "技术学习"}
          </span>

          {
            tags.map((tag) => {
              const tagMeta = getBlogTagMeta(tag);
              const token = tagMeta.styleToken || DEFAULT_TAG_META.styleToken;

              return (
                <span
                  class={`tag-pill inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded border tag-token-${token}`}
                >
                  <Icon name={tagMeta.icon} class="w-4 h-4" />
                  {tagMeta.label}
                </span>
              );
            })
          }
        </div>

        <h1
          class="text-3xl md:text-5xl font-bold text-ink-900 dark:text-zinc-100 leading-tight tracking-tight"
        >
          {title}
        </h1>

        <div
          class="mt-4 flex flex-wrap items-center gap-3 text-sm text-ink-500 dark:text-zinc-400 uppercase tracking-widest"
        >
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <span class="inline-flex items-center gap-1">
                <Icon name="mingcute:refresh-2-line" class="w-4 h-4" />
                Updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </div>
      </header>

      {
        heroImage && (
          <div class="w-full mb-10 md:mb-14 group">
            <img
              src={heroImage.src}
              alt={title}
              loading="eager"
              decoding="async"
              class="w-full h-auto object-cover rounded-sm shadow-ink transition-transform duration-500 md:group-hover:scale-[1.01]"
            />
          </div>
        )
      }

      <MobileReadingNavigation series={series} headings={headings} />

      <div class="prose prose-sm md:prose-base prose-ink max-w-none">
        <slot />
      </div>

      <SeriesPostPager series={series} />
    </article>
  </div>

  <BackToTop />

  <TechnicalReadingRuntime />
  <TechnicalCodeRuntime />
</BaseLayout>

<style>
  .tag-pill {
    border-color: var(--tag-border, var(--tag-default-border));
    background: var(--tag-bg, var(--tag-default-bg));
    color: var(--tag-text, var(--tag-default-text));
    box-shadow: var(--tag-shadow, var(--tag-default-shadow));
    backdrop-filter: blur(2px);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .tag-pill:hover {
    border-color: var(--tag-border-hover, var(--tag-border));
    background: var(--tag-bg-hover, var(--tag-bg));
    box-shadow: var(--tag-shadow-hover, var(--tag-shadow));
    transform: translateY(-1px);
  }

  :global(.dark) .tag-pill:hover {
    border-color: var(--tag-border);
    background: var(--tag-bg);
    box-shadow: var(--tag-shadow);
  }

  .tag-pill :global(svg) {
    opacity: 0.9;
  }

  .side-scroll-fade {
    --side-scroll-top-fade: var(--mask-visible-stop);
    --side-scroll-bottom-fade: var(--mask-visible-stop);
    --side-scroll-fade-size: 1.75rem;
    -webkit-mask-image: linear-gradient(
      to bottom,
      var(--side-scroll-top-fade),
      var(--mask-visible-stop) var(--side-scroll-fade-size),
      var(--mask-visible-stop) calc(100% - var(--side-scroll-fade-size)),
      var(--side-scroll-bottom-fade)
    );
    mask-image: linear-gradient(
      to bottom,
      var(--side-scroll-top-fade),
      var(--mask-visible-stop) var(--side-scroll-fade-size),
      var(--mask-visible-stop) calc(100% - var(--side-scroll-fade-size)),
      var(--side-scroll-bottom-fade)
    );
  }

  .side-scroll-fade.has-top-fade {
    --side-scroll-top-fade: transparent;
  }

  .side-scroll-fade.has-bottom-fade {
    --side-scroll-bottom-fade: transparent;
  }

  .tag-token-default {
    --tag-border: var(--tag-default-border);
    --tag-bg: var(--tag-default-bg);
    --tag-text: var(--tag-default-text);
    --tag-shadow: var(--tag-default-shadow);
    --tag-border-hover: var(--tag-default-border-hover);
    --tag-bg-hover: var(--tag-default-bg-hover);
    --tag-shadow-hover: var(--tag-default-shadow-hover);
  }

  .tag-token-ai {
    --tag-border: var(--tag-ai-border);
    --tag-bg: var(--tag-ai-bg);
    --tag-text: var(--tag-ai-text);
    --tag-shadow: var(--tag-ai-shadow);
    --tag-border-hover: var(--tag-ai-border-hover);
    --tag-bg-hover: var(--tag-ai-bg-hover);
    --tag-shadow-hover: var(--tag-ai-shadow-hover);
  }

  .tag-token-interaction {
    --tag-border: var(--tag-interaction-border);
    --tag-bg: var(--tag-interaction-bg);
    --tag-text: var(--tag-interaction-text);
    --tag-shadow: var(--tag-interaction-shadow);
    --tag-border-hover: var(--tag-interaction-border-hover);
    --tag-bg-hover: var(--tag-interaction-bg-hover);
    --tag-shadow-hover: var(--tag-interaction-shadow-hover);
  }

  .tag-token-design {
    --tag-border: var(--tag-design-border);
    --tag-bg: var(--tag-design-bg);
    --tag-text: var(--tag-design-text);
    --tag-shadow: var(--tag-design-shadow);
    --tag-border-hover: var(--tag-design-border-hover);
    --tag-bg-hover: var(--tag-design-bg-hover);
    --tag-shadow-hover: var(--tag-design-shadow-hover);
  }

  .tag-token-frontend {
    --tag-border: var(--tag-frontend-border);
    --tag-bg: var(--tag-frontend-bg);
    --tag-text: var(--tag-frontend-text);
    --tag-shadow: var(--tag-frontend-shadow);
    --tag-border-hover: var(--tag-frontend-border-hover);
    --tag-bg-hover: var(--tag-frontend-bg-hover);
    --tag-shadow-hover: var(--tag-frontend-shadow-hover);
  }

  .tag-token-backend {
    --tag-border: var(--tag-backend-border);
    --tag-bg: var(--tag-backend-bg);
    --tag-text: var(--tag-backend-text);
    --tag-shadow: var(--tag-backend-shadow);
    --tag-border-hover: var(--tag-backend-border-hover);
    --tag-bg-hover: var(--tag-backend-bg-hover);
    --tag-shadow-hover: var(--tag-backend-shadow-hover);
  }

  .tag-token-algorithm {
    --tag-border: var(--tag-algorithm-border);
    --tag-bg: var(--tag-algorithm-bg);
    --tag-text: var(--tag-algorithm-text);
    --tag-shadow: var(--tag-algorithm-shadow);
    --tag-border-hover: var(--tag-algorithm-border-hover);
    --tag-bg-hover: var(--tag-algorithm-bg-hover);
    --tag-shadow-hover: var(--tag-algorithm-shadow-hover);
  }

  .tag-token-system {
    --tag-border: var(--tag-system-border);
    --tag-bg: var(--tag-system-bg);
    --tag-text: var(--tag-system-text);
    --tag-shadow: var(--tag-system-shadow);
    --tag-border-hover: var(--tag-system-border-hover);
    --tag-bg-hover: var(--tag-system-bg-hover);
    --tag-shadow-hover: var(--tag-system-shadow-hover);
  }

  .tag-token-study {
    --tag-border: var(--tag-study-border);
    --tag-bg: var(--tag-study-bg);
    --tag-text: var(--tag-study-text);
    --tag-shadow: var(--tag-study-shadow);
    --tag-border-hover: var(--tag-study-border-hover);
    --tag-bg-hover: var(--tag-study-bg-hover);
    --tag-shadow-hover: var(--tag-study-shadow-hover);
  }

  .tag-token-database {
    --tag-border: var(--tag-database-border);
    --tag-bg: var(--tag-database-bg);
    --tag-text: var(--tag-database-text);
    --tag-shadow: var(--tag-database-shadow);
    --tag-border-hover: var(--tag-database-border-hover);
    --tag-bg-hover: var(--tag-database-bg-hover);
    --tag-shadow-hover: var(--tag-database-shadow-hover);
  }

  /* --- 阅读导航：保留滚动能力，但隐藏原生滚动条 --- */
  .toc-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .toc-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* --- 代码块功能：macOS 风格的按钮样式 --- */
  .mac-action-base {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mac-action-btn {
    width: 20px;
    height: 20px;
    opacity: 0.6;
  }

  .mac-action-btn:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .mac-copy-btn {
    top: 8px;
    right: 8px;
  }

  .mac-success {
    top: 8px;
    right: 8px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mac-success.show {
    opacity: 1;
  }

  .mac-theme-btn {
    top: 8px;
    right: 32px;
  }

  .mac-toggle-btn {
    bottom: 8px;
    right: 8px;
  }

  /* --- 代码块功能：代码块容器及折叠样式 --- */
  .code-block-wrapper {
    position: relative;
  }

  .code-block-wrapper.style-ink {
    /* 水墨风样式标记 */
  }

  pre.astro-code {
    position: relative;
    overflow-x: auto;
    overflow-y: auto;
    max-height: 500px;
    transition: max-height 0.3s ease;
  }

  pre.astro-code.collapsed {
    max-height: 300px;
  }

  pre.astro-code code {
    display: block;
  }

  /* --- 代码块功能：防止代码块内容选择中断的行选择样式 --- */
  pre.astro-code .line {
    display: block;
    user-select: text;
  }
</style>
