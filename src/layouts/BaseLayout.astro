---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ArticleRuntime from "../components/runtime/ArticleRuntime.astro";
import GlobalAudioRuntime from "../components/runtime/GlobalAudioRuntime.astro";
import GlobalRuntime from "../components/runtime/GlobalRuntime.astro";
import { ClientRouter } from "astro:transitions";
import type { ArticleSeo, SeoImage } from "../utils/seo";
import "katex/dist/katex.min.css";

export interface Props {
  title: string;
  description: string;
  image?: SeoImage;
  article?: ArticleSeo;
  articleRuntime?: boolean;
}
const {
  title,
  description,
  image,
  article,
  articleRuntime = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
    />
    <slot name="head" />
    <ClientRouter />
  </head>

  <body
    class="flex flex-col min-h-screen selection:bg-ink-900 selection:text-white transition-colors duration-500"
  >
    <Header />

    <main class="grow w-full max-w-4xl mx-auto px-6 md:px-8" data-pagefind-body>
      <slot />
    </main>

    <Footer />

    <GlobalAudioRuntime />
    <GlobalRuntime />
    {articleRuntime && <ArticleRuntime />}
  </body>
</html>
