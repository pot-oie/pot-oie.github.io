---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { WatchDetailModel } from "../domain/watch";

interface Props {
  watch: WatchDetailModel;
}

const { watch } = Astro.props;
const {
  title,
  originalTitle,
  releaseDate,
  finishedDate,
  coverImage,
  shortReview,
} = watch.data;

const { sortedSeasons, score: averageRating, pending } = watch;
const releaseYear = releaseDate?.getFullYear();
const description = shortReview || `${title}的剧集观影记录`;
---

<BaseLayout title={`${title} - 观影记录`} description={description}>
  <div class="max-w-4xl mx-auto py-8 md:py-16 px-4">
    <aside class="mb-10">
      <a
        href="/watch/series/"
        class="inline-flex items-center gap-2 text-ink-500 dark:text-zinc-400 hover:text-vermilion dark:hover:text-vermilion transition-all text-sm tracking-widest uppercase group active:scale-95"
      >
        <Icon
          name="mingcute:arrow-left-line"
          class="group-hover:-translate-x-1 transition-transform"
        />
        <span>Watch Archives</span>
      </a>
    </aside>

    <div
      class="md:grid md:grid-cols-[240px_1fr] md:gap-x-20 md:items-start relative"
    >
      <aside class="md:sticky md:top-24 mb-12 md:mb-0 z-10 w-full md:w-60">
        <div class="group flex flex-col gap-6">
          <div
            class="relative w-full aspect-2/3 rounded-sm overflow-hidden shadow-2xl transition-transform duration-500 md:group-hover:scale-[1.02]"
          >
            <Image
              src={coverImage}
              alt={title}
              width={600}
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-x-0 top-0 flex justify-between gap-3 p-3">
              <span
                class="bg-ink-100/90 dark:bg-zinc-900/85 backdrop-blur-sm px-2 py-1 text-[10px] font-sans font-bold tracking-[0.18em] uppercase text-ink-700 dark:text-zinc-200 rounded-sm shadow-sm"
              >
                Series
              </span>
              {
                pending && (
                  <span class="bg-ink-900/80 backdrop-blur-sm px-2 py-1 text-[9px] font-sans font-bold tracking-widest text-ink-100 rounded-sm shadow-sm">
                    TO WATCH
                  </span>
                )
              }
            </div>
          </div>

          <div class="flex flex-col gap-2 px-1">
            <p
              class="text-[10px] md:text-xs font-sans text-ink-400 dark:text-zinc-500 tracking-[0.25em] uppercase"
            >
              {
                [
                  "Series",
                  releaseYear ? String(releaseYear) : null,
                ]
                  .filter(Boolean)
                  .join(" · ")
              }
            </p>
            <div class="flex items-baseline gap-2 text-vermilion">
              <span class="text-[10px] font-sans tracking-widest uppercase">
                Avg.
              </span>
              <span class="font-serif text-3xl font-black italic">
                {averageRating.toFixed(1)}
              </span>
              <span class="text-xs text-ink-300 dark:text-zinc-500">/ 5</span>
            </div>
          </div>
        </div>
      </aside>

      <article class="min-w-0 flex-1">
        <header
          class="mb-10 md:mb-12 border-b border-ink-300/30 dark:border-zinc-700 pb-8"
        >
          <div
            class="flex flex-wrap items-center gap-x-5 gap-y-2 text-ink-400 dark:text-zinc-500 text-xs font-sans tracking-[0.16em] uppercase mb-6"
          >
            {
              releaseDate && (
                <span class="inline-flex items-center gap-2">
                  <span>Premiered</span>
                  <FormattedDate date={releaseDate} />
                </span>
              )
            }
            {
              finishedDate && (
                <span class="inline-flex items-center gap-2">
                  <span>Finished</span>
                  <FormattedDate date={finishedDate} />
                </span>
              )
            }
          </div>

          <h1
            class="text-4xl md:text-6xl font-serif font-black text-ink-900 dark:text-zinc-100 leading-[1.1] tracking-tighter"
          >
            {title}
          </h1>
          {
            originalTitle && originalTitle !== title && (
              <p class="mt-3 text-sm font-sans tracking-[0.12em] text-ink-300 dark:text-zinc-500">
                {originalTitle}
              </p>
            )
          }

          {
            shortReview && (
              <p
                class="mt-8 border-l-2 border-vermilion/60 pl-5 text-lg md:text-xl font-serif italic leading-relaxed text-ink-600 dark:text-zinc-300"
              >
                {shortReview}
              </p>
            )
          }
        </header>

        <section aria-labelledby="season-ratings-title">
              <div class="mb-6 flex items-end justify-between gap-4">
                <div>
                  <p class="text-[10px] font-sans tracking-[0.24em] uppercase text-ink-300 dark:text-zinc-500">
                    Season Notes
                  </p>
                  <h2
                    id="season-ratings-title"
                    class="mt-1 text-2xl md:text-3xl font-serif font-black text-ink-900 dark:text-zinc-100"
                  >
                    季度记录
                  </h2>
                </div>
                <span class="text-xs font-sans text-ink-300 dark:text-zinc-500">
                  {sortedSeasons.length} Seasons
                </span>
              </div>

              <div class="border-t border-ink-300/30 dark:border-zinc-700">
                {sortedSeasons.map((season) => {
                  const isPending = season.rating === "to-watch";
                  const score =
                    typeof season.rating === "number" ? season.rating : null;
                  const width = score === null ? 0 : (score / 5) * 100;
                  const seasonCode = `S${String(season.number).padStart(2, "0")}`;

                  return (
                    <div class="grid grid-cols-[56px_minmax(0,1fr)_auto] items-start gap-4 border-b border-ink-300/20 py-5 dark:border-zinc-800 md:grid-cols-[72px_minmax(0,1fr)_auto] md:gap-5 md:py-6">
                      <div class="relative aspect-2/3 overflow-hidden rounded-sm border border-ink-300/30 bg-ink-200/30 shadow-sm dark:border-zinc-700 dark:bg-zinc-800/50">
                        {season.posterImage ? (
                          <Image
                            src={season.posterImage}
                            alt={`${title} ${seasonCode} 季度海报`}
                            width={180}
                            class="h-full w-full object-cover"
                          />
                        ) : (
                          <div class="flex h-full flex-col items-center justify-center gap-1">
                            <span class="font-serif text-sm font-black text-ink-700 dark:text-zinc-200 md:text-base">
                              {seasonCode}
                            </span>
                            <span class="text-[7px] font-sans tracking-[0.18em] text-ink-300 uppercase dark:text-zinc-500">
                              Season
                            </span>
                          </div>
                        )}
                      </div>

                      <div class="min-w-0 pt-0.5">
                        <p class="font-serif text-lg font-black text-ink-900 dark:text-zinc-100">
                          {seasonCode}
                        </p>
                        <div class="mt-3 h-px overflow-hidden bg-ink-300/20 dark:bg-zinc-700">
                          {!isPending && (
                            <div
                              class="h-full bg-vermilion"
                              style={`width: ${width}%`}
                            />
                          )}
                        </div>
                        {season.shortReview && (
                          <p class="mt-4 font-serif text-sm leading-relaxed text-ink-600 dark:text-zinc-300 md:text-[15px]">
                            {season.shortReview}
                          </p>
                        )}
                      </div>

                      <div class="pt-0.5">
                        {isPending ? (
                          <span class="block min-w-20 border border-dashed border-ink-300 px-2.5 py-1 text-center text-[10px] font-sans font-bold tracking-[0.14em] text-ink-400 dark:border-zinc-600 dark:text-zinc-400">
                            TO WATCH
                          </span>
                        ) : (
                          <span class="block min-w-16 border border-vermilion px-2.5 py-1 text-center font-serif text-lg font-bold italic text-vermilion">
                            {score?.toFixed(1)}
                          </span>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
