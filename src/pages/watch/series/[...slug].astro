---
import { getCollection } from "astro:content";
import WatchDetail from "../../../layouts/WatchDetail.astro";
import {
  getWatchSlug,
  isSeriesWatchEntry,
  resolveWatchDetail,
  type WatchDetailModel,
} from "../../../domain/watch";

export async function getStaticPaths() {
  const watchPosts = await getCollection("watch");

  return watchPosts
    .filter(isSeriesWatchEntry)
    .map((post) => ({
      params: { slug: getWatchSlug(post) },
      props: { watch: resolveWatchDetail(post) },
    }));
}

interface Props {
  watch: WatchDetailModel;
}

const { watch } = Astro.props;
---

<WatchDetail watch={watch} />
