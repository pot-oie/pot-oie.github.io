---
import { getCollection, type CollectionEntry } from "astro:content";
import WatchDetail from "../../../layouts/WatchDetail.astro";
import { getWatchSlug } from "../../../domain/watch";

export async function getStaticPaths() {
  const watchPosts = await getCollection("watch");

  return watchPosts
    .filter((post) => post.data.mediaType === "series")
    .map((post) => ({
    params: { slug: getWatchSlug(post) },
    props: { post },
    }));
}

interface Props {
  post: CollectionEntry<"watch">;
}

const { post } = Astro.props;
---

<WatchDetail post={post} />
