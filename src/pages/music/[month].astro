---
// src/pages/music/[month].astro
import { getCollection } from "astro:content";
import MusicCalendarView from "../../components/MusicCalendarView.astro";
import { getMonthKey } from "../../utils/calendar";
import { getStandaloneTracks, resolveMusicTracks } from "../../domain/music";

export async function getStaticPaths() {
  const [rawMusic, albums] = await Promise.all([
    getCollection("music"),
    getCollection("albums"),
  ]);
  const allMusic = getStandaloneTracks(resolveMusicTracks(rawMusic, albums));
  const months = new Set(
    allMusic.map((post) => getMonthKey(post.data.recordedAt)),
  );

  // 确保当月即使没有数据也能生成一个空日历页
  months.add(getMonthKey(new Date()));

  return Array.from(months).map((monthKey) => ({
    params: { month: monthKey },
  }));
}

const { month } = Astro.params;
const [rawMusic, albums] = await Promise.all([
  getCollection("music"),
  getCollection("albums"),
]);
const music = resolveMusicTracks(rawMusic, albums);
---

<MusicCalendarView targetMonthKey={month} music={music} />
