---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import SpaceEdition from "../../components/space/2026/SpaceEdition.astro";
import Space2026Layout from "../../layouts/space/Space2026Layout.astro";
import { SPACE_EDITION } from "../../utils/space/2026/edition";
import { resolveSpaceEdition } from "../../utils/space/2026/resolveSpaceEdition";

const [blogs, watches, tracks] = await Promise.all([
  getCollection("blog"),
  getCollection("watch"),
  getCollection("music"),
]);

const edition = await resolveSpaceEdition({
  config: SPACE_EDITION,
  blogs,
  watches,
  tracks,
  optimizePoster: async (src) => {
    const [compact, large] = await Promise.all([
      getImage({ src, width: 480, height: 720, format: "webp", quality: 76, fit: "cover" }),
      getImage({ src, width: 900, height: 1350, format: "webp", quality: 80, fit: "cover" }),
    ]);

    return {
      src: large.src,
      srcset: `${compact.src} 480w, ${large.src} 900w`,
      width: 900,
      height: 1350,
    };
  },
});

---

<Space2026Layout
  title="Space 2025.08—2026.08 — 桂圆子"
  description="Learning, film, music, development, and direction in the 2025.08—2026.08 Space edition."
>
  <SpaceEdition edition={edition} />
</Space2026Layout>
