---
import { Image } from "astro:assets";
import ArchiveHeader from "../../components/ArchiveHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getCurrentSpaceEdition,
  SPACE_EDITIONS,
} from "../../utils/space/editions";
import { SPACE_EDITIONS_WITH_COVERS } from "../../utils/space/editionCovers";

const currentEdition = getCurrentSpaceEdition();
const pageTitle = "Space — 桂圆子";
const pageDescription =
  "Space 是桂圆子的年度出版物：以独立的视觉与交互，记录每一年正在发生的学习、观看、聆听、开发与方向。";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <meta slot="head" name="robots" content="index, follow" />

  <section class="py-8 md:py-16" aria-label="Space 年鉴">
    <ArchiveHeader
      breadcrumbs={[{ label: "Home", href: "/" }, { label: "Space" }]}
      title="Space / 年鉴"
      description="All in a year."
      count={SPACE_EDITIONS.length}
      countIcon="mingcute:book-6-line"
      metadata={[`Current ${currentEdition.year} · ${currentEdition.period}`]}
    />

    <ol class="space-edition-list mx-auto max-w-4xl" aria-label="Space 年度版本">
      {
        SPACE_EDITIONS_WITH_COVERS.map((edition, index) => (
          <li>
            <a
              href={edition.href}
              data-astro-reload
              class:list={[
                "space-edition-card group",
                edition.cover && "space-edition-card--illustrated",
              ]}
              aria-label={`打开 ${edition.title}，${edition.period}`}
            >
              {edition.cover && (
                <span class="space-edition-visual" aria-hidden="true">
                  <Image
                    src={edition.cover}
                    alt=""
                    widths={[896, 1344, 1792, 2243]}
                    sizes="(min-width: 768px) 56rem, 100vw"
                    format="webp"
                    quality={95}
                    class="space-edition-image"
                  />
                </span>
              )}
              <span class="space-edition-copy">
                <span class="mb-2 block text-[0.65rem] font-semibold tracking-[0.18em] text-ink-300 md:mb-3 md:text-xs dark:text-zinc-600">
                  Edition {String(index + 1).padStart(2, "0")}
                </span>
                <span class="flex flex-wrap items-baseline gap-x-2 gap-y-1 md:gap-x-4 md:gap-y-2">
                  <strong class="font-serif text-2xl text-ink-900 md:text-4xl dark:text-zinc-100">
                    {edition.title}
                  </strong>
                  {edition.current && (
                    <small class="border border-vermilion px-2 py-1 text-[0.62rem] font-bold tracking-[0.16em] text-vermilion uppercase">
                      Current
                    </small>
                  )}
                </span>
                <span class="mt-2 block text-xs font-semibold tracking-[0.12em] text-ink-500 md:mt-3 md:text-sm dark:text-zinc-400">
                  {edition.period}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .space-edition-list {
    display: grid;
    gap: 1.5rem;
  }

  .space-edition-card {
    --space-edition-surface: var(--bg-card);
    position: relative;
    z-index: 10000;
    display: block;
    min-height: 9.5rem;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
  }

  .space-edition-copy {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
  }

  .space-edition-card--illustrated .space-edition-copy {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(94%, 32rem);
    padding-right: 4rem;
    isolation: isolate;
  }

  .space-edition-card--illustrated .space-edition-copy::before {
    position: absolute;
    z-index: -1;
    inset: -1px -6rem -1px -1px;
    content: "";
    background: var(--space-edition-surface);
    filter: drop-shadow(18px 6px 18px rgb(var(--color-rgb-shadow) / 0.24));
    -webkit-mask-image: linear-gradient(
      118deg,
      var(--mask-visible-stop) 0%,
      var(--mask-visible-stop) 60%,
      transparent 82%
    );
    mask-image: linear-gradient(
      118deg,
      var(--mask-visible-stop) 0%,
      var(--mask-visible-stop) 60%,
      transparent 82%
    );
    pointer-events: none;
  }

  .space-edition-visual {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .space-edition-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .space-edition-card--illustrated {
      min-height: 11rem;
    }

    .space-edition-card--illustrated .space-edition-copy {
      width: min(62%, 34rem);
      padding: 1.75rem 7rem 1.75rem 3rem;
    }
  }

  @media (min-width: 48rem) and (hover: hover) {
    .space-edition-card--illustrated .space-edition-copy {
      opacity: 0;
      transform: translateX(-105%);
      transition:
        opacity 260ms ease,
        transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .space-edition-card--illustrated:is(:hover, :focus-visible) .space-edition-copy {
      opacity: 1;
      transform: translateX(0);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .space-edition-card,
    .space-edition-copy {
      transition-duration: 1ms;
    }
  }
</style>
