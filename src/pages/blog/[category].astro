---
// src/pages/blog/[category].astro

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import ArchiveHeader from "../../components/ArchiveHeader.astro";
import { Icon } from "astro-icon/components";
import {
  getBlogCategoryFilters,
  sortBlogPosts,
} from "../../utils/blogArchive";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });
  const categoryMeta = {
    learn: {
      title: "Notes / 学习",
      description: "Ideas learned, tested, understood.",
      breadcrumb: "Learn",
    },
    life: {
      title: "Essays / 生活",
      description: "Ordinary days, music, cinema, and thoughts in between.",
      breadcrumb: "Life",
    },
  } as const;

  return (["learn", "life"] as const).map((category) => {
    const posts = allPosts.filter((post) => post.data.category === category);
    return {
      params: { category },
      props: {
        posts: sortBlogPosts(posts),
        filters: getBlogCategoryFilters(allPosts, category),
        pageMeta: categoryMeta[category],
      },
    };
  });
}

const { posts, filters, pageMeta } = Astro.props;
---

<BaseLayout title={pageMeta.title} description={pageMeta.description}>
  <section class="py-8 md:py-16">
    <ArchiveHeader
      breadcrumbs={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog/" },
        { label: pageMeta.breadcrumb },
      ]}
      title={pageMeta.title}
      description={pageMeta.description}
      count={posts.length}
      filters={filters}
      filterLabel={`${pageMeta.breadcrumb}分类`}
      activeFilter="all"
    />

    <div class="flex flex-col max-w-4xl mx-auto">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <div class="mt-20 text-center">
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-ink-500 dark:text-zinc-400 hover:text-vermilion transition-colors text-sm tracking-widest uppercase"
      >
        <Icon name="mingcute:arrow-left-line" />
        <span>Back to Blog</span>
      </a>
    </div>
  </section>
</BaseLayout>
