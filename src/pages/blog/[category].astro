---
// src/pages/blog/[category].astro

import { getCollection } from "astro:content";
import BlogArchive from "../../layouts/BlogArchive.astro";
import {
  getBlogCategoryArchive,
  getPaginatedBlogArchive,
  getPublishedBlogPosts,
} from "../../domain/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = getPublishedBlogPosts(allPosts);
  const categoryMeta = {
    learn: {
      title: "Notes / 学习",
      description: "Ideas learned, tested, understood.",
      breadcrumb: "Learn",
    },
    life: {
      title: "Essays / 生活",
      description: "Ordinary days, music, cinema, and thoughts in between.",
      breadcrumb: "Life",
    },
  } as const;

  return (["learn", "life"] as const).map((category) => {
    const archive = getPaginatedBlogArchive(
      getBlogCategoryArchive(publishedPosts, category),
      1,
      `/blog/${category}/`,
    )!;
    return {
      params: { category },
      props: {
        ...archive,
        pageMeta: categoryMeta[category],
      },
    };
  });
}

const { posts, filters, pagination, pageMeta } = Astro.props;
---

<BlogArchive
  title={pageMeta.title}
  description={pageMeta.description}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog/" },
    { label: pageMeta.breadcrumb },
  ]}
  posts={posts}
  filters={filters}
  pagination={pagination}
  filterLabel={`${pageMeta.breadcrumb}分类`}
  activeFilter="all"
  backHref="/blog/"
  backLabel="Back to Blog"
/>
