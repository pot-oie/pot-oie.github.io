---
import { getCollection } from "astro:content";
import BlogArchive from "../../layouts/BlogArchive.astro";
import {
  getBlogRootArchive,
  getPaginatedBlogArchive,
  getPublishedBlogPosts,
} from "../../domain/blog";

const allPosts = await getCollection("blog");
const publishedPosts = getPublishedBlogPosts(allPosts);
const archive = getPaginatedBlogArchive(
  getBlogRootArchive(publishedPosts),
  1,
  "/blog/",
)!;
const pageTitle = "Blog / 文集";
const pageDescription = "Notes and essays, collected.";
---

<BlogArchive
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog" },
  ]}
  posts={archive.posts}
  filters={archive.filters}
  pagination={archive.pagination}
  filterLabel="博客分类"
  activeFilter="all"
  backHref="/"
  backLabel="Back to Home"
  backIcon="mingcute:home-4-line"
/>
