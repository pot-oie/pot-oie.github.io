---
// src/pages/blog/life/[lifeCategory].astro
import { getCollection } from "astro:content";
import BlogArchive from "../../../layouts/BlogArchive.astro";
import { LIFE_CATEGORY_META_LIST } from "../../../consts";
import {
  getBlogLifeCategoryArchive,
  getPaginatedBlogArchive,
  getPublishedBlogPosts,
} from "../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = getPublishedBlogPosts(allPosts);

  return LIFE_CATEGORY_META_LIST.map((meta) => {
    const archive = getPaginatedBlogArchive(
      getBlogLifeCategoryArchive(publishedPosts, meta.key),
      1,
      `/blog/life/${meta.slug}/`,
    )!;

    return {
      params: { lifeCategory: meta.slug },
      props: {
        ...archive,
        meta,
      },
    };
  });
}

const { posts, meta, filters, pagination } = Astro.props;
const pageTitle = `${meta.englishLabel} / ${meta.label}`;
---

<BlogArchive
  title={pageTitle}
  description={meta.description}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog/" },
    { label: "Life", href: "/blog/life/" },
    { label: meta.slug },
  ]}
  posts={posts}
  filters={filters}
  pagination={pagination}
  filterLabel="生活分类"
  activeFilter={meta.key}
  backHref="/blog/life/"
  backLabel="Back to Life Archives"
/>
