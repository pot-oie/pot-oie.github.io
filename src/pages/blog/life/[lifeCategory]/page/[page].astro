---
import { getCollection } from "astro:content";
import { LIFE_CATEGORY_META_LIST } from "../../../../../consts";
import BlogArchive from "../../../../../layouts/BlogArchive.astro";
import {
  getBlogArchivePageNumbers,
  getBlogLifeCategoryArchive,
  getPaginatedBlogArchive,
  getPublishedBlogPosts,
} from "../../../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = getPublishedBlogPosts(allPosts);

  return LIFE_CATEGORY_META_LIST.flatMap((meta) => {
    const archive = getBlogLifeCategoryArchive(publishedPosts, meta.key);

    return getBlogArchivePageNumbers(archive.posts.length)
      .slice(1)
      .map((page) => ({
        params: { lifeCategory: meta.slug, page: String(page) },
        props: {
          ...getPaginatedBlogArchive(
            archive,
            page,
            `/blog/life/${meta.slug}/`,
          )!,
          meta,
        },
      }));
  });
}

const { posts, filters, pagination, meta } = Astro.props;
const pageTitle = `${meta.englishLabel} / ${meta.label}`;
---

<BlogArchive
  title={pageTitle}
  description={meta.description}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog/" },
    { label: "Life", href: "/blog/life/" },
    { label: meta.slug },
  ]}
  posts={posts}
  filters={filters}
  pagination={pagination}
  filterLabel="生活分类"
  activeFilter={meta.key}
  backHref="/blog/life/"
  backLabel="Back to Life Archives"
/>
