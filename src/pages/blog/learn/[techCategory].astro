---
import { getCollection } from "astro:content";
import BlogArchive from "../../../layouts/BlogArchive.astro";
import { TECH_CATEGORY_META_LIST } from "../../../consts";
import {
  getBlogTechCategoryArchive,
  getPaginatedBlogArchive,
  getPublishedBlogPosts,
} from "../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const publishedPosts = getPublishedBlogPosts(allPosts);

  return TECH_CATEGORY_META_LIST.map((meta) => {
    const archive = getPaginatedBlogArchive(
      getBlogTechCategoryArchive(publishedPosts, meta.key),
      1,
      `/blog/learn/${meta.slug}/`,
    )!;

    return {
      params: { techCategory: meta.slug },
      props: {
        ...archive,
        meta,
      },
    };
  });
}

const { posts, meta, filters, pagination } = Astro.props;
const pageTitle = `${meta.englishLabel} / ${meta.label}`;
---

<BlogArchive
  title={pageTitle}
  description={meta.description}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog", href: "/blog/" },
    { label: "Learn", href: "/blog/learn/" },
    { label: meta.slug },
  ]}
  posts={posts}
  filters={filters}
  pagination={pagination}
  filterLabel="学习分类"
  activeFilter={meta.key}
  backHref="/blog/learn/"
  backLabel="Back to Learn Archives"
/>
