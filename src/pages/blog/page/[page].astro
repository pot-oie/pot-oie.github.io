---
import { getCollection } from "astro:content";
import BlogArchive from "../../../layouts/BlogArchive.astro";
import {
  getBlogArchivePageNumbers,
  getBlogRootArchive,
  getPaginatedBlogArchive,
  getPublishedBlogPosts,
} from "../../../domain/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const archive = getBlogRootArchive(getPublishedBlogPosts(allPosts));

  return getBlogArchivePageNumbers(archive.posts.length)
    .slice(1)
    .map((page) => ({
      params: { page: String(page) },
      props: getPaginatedBlogArchive(archive, page, "/blog/")!,
    }));
}

const { posts, filters, pagination } = Astro.props;
const pageTitle = "Blog / 文集";
const pageDescription = "Notes and essays, collected.";
---

<BlogArchive
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Blog" },
  ]}
  posts={posts}
  filters={filters}
  pagination={pagination}
  filterLabel="博客分类"
  activeFilter="all"
  backHref="/"
  backLabel="Back to Home"
  backIcon="mingcute:home-4-line"
/>
