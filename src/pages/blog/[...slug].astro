---
// src/pages/blog/[...slug].astro
import { getCollection, render } from "astro:content";
import LifePost from "../../layouts/LifePost.astro";
import TechPost from "../../layouts/TechPost.astro";
import AlbumPost from "../../layouts/AlbumPost.astro";
import {
  getBlogSeriesForPost,
  getPublishedBlogPosts,
  type BlogPost,
  type BlogSeries,
} from "../../domain/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const posts = getPublishedBlogPosts(allPosts);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: {
      post,
      series: getBlogSeriesForPost(posts, post),
    },
  }));
}
type Props = {
  post: BlogPost;
  series?: BlogSeries;
};

const { post, series } = Astro.props;
const { Content, headings } = await render(post);
---

{
  post.data.category === "life" ? (
    post.data.lifeCategory === "album" ? (
      <AlbumPost {...post.data}>
        <Content />
      </AlbumPost>
    ) : (
      <LifePost {...post.data}>
        <Content />
      </LifePost>
    )
  ) : (
    <TechPost {...post.data} headings={headings} series={series}>
      <Content />
    </TechPost>
  )
}
