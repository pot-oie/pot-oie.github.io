---
import type { ResolvedSpaceEdition } from "../../../utils/space/2026/edition";
import SpaceAbstractExhibition from "./SpaceAbstractExhibition.astro";
import SpaceColophon from "./SpaceColophon.astro";
import SpaceDetails from "./SpaceDetails.astro";

interface Props { edition: ResolvedSpaceEdition }
const { edition } = Astro.props;
---

<main class="space-edition" data-space-edition data-film-count={edition.randomSelection.filmCount} data-track-count={edition.randomSelection.trackCount} data-track-artist-limit={edition.randomSelection.maxTracksPerArtist} data-track-date-limit={edition.randomSelection.maxTracksPerDate} data-pagefind-ignore>
  <p class="space-skip"><a href="#learning-detail">跳到内容空间</a></p>
  <nav class="space-back-nav" aria-label="返回导航">
    <a href="/" data-astro-reload>← HOME</a>
    <a href="/space" data-astro-reload>← SPACE INDEX</a>
  </nav>
  <div class="space-linear-intro" aria-hidden="true"><span>SPACE / {edition.period}</span><span>{edition.identity.operatorLatin} · {edition.identity.location}</span></div>

  <SpaceAbstractExhibition edition={edition} />
  <SpaceDetails edition={edition} />
  <SpaceColophon edition={edition} />

  <div class="transition-plane" data-transition-plane aria-hidden="true"></div>
  <p class="space-runtime-status sr-only" data-space-status aria-live="polite"></p>
</main>

<script>
  import { initializeSpaceEdition } from "../../../scripts/space/2026";
  initializeSpaceEdition();
</script>
