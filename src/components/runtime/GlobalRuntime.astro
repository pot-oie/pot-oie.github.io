<script>
  import { installAnalytics } from "../../scripts/runtime/analytics";
  import { scrollToLocationHash } from "../../scripts/runtime/hashScroll";
  import { initLenis } from "../../scripts/runtime/lenis";

  const initializedRoots = new WeakSet<Element>();

  function initGlobalRuntime() {
    const root = document.querySelector("main");
    if (!root || initializedRoots.has(root)) return;
    initializedRoots.add(root);

    initLenis();
    installAnalytics();

    // View Transitions 后如果 URL 带 hash，用 Lenis 精准跳转并做延迟重试。
    requestAnimationFrame(scrollToLocationHash);
  }

  document.addEventListener("astro:page-load", initGlobalRuntime);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGlobalRuntime, {
      once: true,
    });
  } else {
    initGlobalRuntime();
  }
</script>
